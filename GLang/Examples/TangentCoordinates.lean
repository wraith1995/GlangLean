import GLang.Examples.Paper
import GLang.Proofs.Value.Binding.ValueWeakening

namespace GLang.Examples.TangentCoordinates

open Basis (BasisValid)
open Examples.Paper (castΔ pair_ctx pair_disjoint smul_const tprodE_vars)

def dualEval (s : Space) : Term :=
  .llam (.dual s) (.dual s) (.llam s .real (.appI s (.bvar 1) (.bvar 0)))

/-- Its matching tangent/cotangent basis. -/
def dualEvalBasis (b : Basis) : Basis := .tprod (.dual (.dual b)) (.dual b)

/-- The exact scalar contraction emitted by the dual-application rule. -/
def pairingCode (sv : ValSpace) (v w : ValExpr) : ValExpr :=
  .ttv sv (.reshap v (.space (.tprod sv .real)) (.space sv)) w

/-- Column assembly for a linear functional. Retains all runtime shape checks. -/
def functionalColumns (sv : ValSpace) (f : Fin (ValSpace.dofUB sv) → ValExpr) : ValExpr :=
  .sumAt sv (List.ofFn fun j =>
    .scale (.reshap (f j) (.space .real) (.space .real)) (.delta j.val sv)) sv

/-- Column assembly for an array-valued linear map. -/
def tensorColumns (dom cod : ValSpace)
    (f : Fin (ValSpace.dofUB dom) → ValExpr) : ValExpr :=
  .sumAt dom (List.ofFn fun i =>
    .tprodE (.delta i.val dom) (.reshap (f i) (.space cod) (.space cod)))
    (.tprod dom cod)

/-- A delta-contraction matrix: numerically the identity, with explicit sums and
shape annotations retained by the operational rules. -/
def dualEvalCode (sv : ValSpace) : ValExpr :=
  tensorColumns sv sv fun i => functionalColumns sv fun j =>
    pairingCode sv (.delta i.val sv) (.delta j.val sv)

noncomputable def dualEval_hasType {Γ : NLCtx} {s : Space} (hs : SValid Γ s) :
    HasType ∅ Γ (dualEval s) (.space (.tprod (.dual (.dual s)) (.dual s))) := by
  unfold dualEval
  refine HasType.llam_tensor ∅ (by intro h; cases h) (.dual hs) (.dual hs)
    (fun y _ => ?_)
  simp only [Nat.reduceAdd, Nat.reduceEqDiff, ↓reduceIte, Term.openVar, Term.openRec, Space.openRec, Space.openRec_lc (SValid.lc hs)]
  refine HasType.llam_real {y} hs (fun z hz => ?_)
  simp only [Finset.mem_singleton] at hz
  simp only [↓reduceIte, Term.openVar, Term.openRec, Space.openRec_lc (SValid.lc hs)]
  rw [pair_ctx y z (.dual s) s (Ne.symm hz)]
  exact HasType.app_inner hs (pair_disjoint (Ne.symm hz)) HasType.var_lin HasType.var_lin

theorem dualEvalBasis_valid {Γ : NLCtx} {b : Basis}
    (hb : BasisValid Γ b) (ht : b.tof = .space b.sof) :
    BasisValid Γ (dualEvalBasis b) :=
  .tprod (.dual (.dual hb ht) rfl) (.dual hb ht) rfl rfl

/-- Explicit lowering of the evaluation tensor in *any* matching basis.
Only the realized space `sv` appears in the generated expression. -/
theorem dualEval_op {Ψ : EvalCtx} {b : Basis} {sv : ValSpace}
    (ht : b.tof = .space b.sof) (hlc : Space.lc b.sof)
    (hs : ValSpace.EvalS Ψ b.sof sv) :
    ValExpr.OpStep Ψ (dualEval b.sof) (dualEvalBasis b) (dualEvalCode sv) := by
  unfold dualEval dualEvalBasis dualEvalCode tensorColumns
  refine ValExpr.OpStep.llam_assemble (b' := .dual b) (b := .dual b) rfl (.dual hs) (.dual hs) Ψ.avoid
    (fun y hy i => ?_)
  have hyfresh := (EvalCtx.avoid_spec hy).1 (.dual b)
  have hsy : ValSpace.EvalS (Ψ.extend y (.dual b) (.delta i.val sv)) b.sof sv :=
    evalS_wk hs hyfresh
  simp only [Nat.reduceAdd, Nat.reduceEqDiff, ↓reduceIte, Term.openVar, Term.openRec, Space.openRec_lc hlc]
  unfold functionalColumns
  refine ValExpr.OpStep.llam_assemble_real ht hsy
    ((Ψ.extend y (.dual b) (.delta i.val sv)).avoid ∪ {y}) (fun z hz j => ?_)
  have hzavoid : z ∉ (Ψ.extend y (.dual b) (.delta i.val sv)).avoid :=
    fun h => hz (Finset.mem_union_left _ h)
  have hzy : z ≠ y := fun h => hz (Finset.mem_union_right _ (by simp [h]))
  have hsz := evalS_wk (v₀ := .delta j.val sv) hsy ((EvalCtx.avoid_spec hzavoid).1 b)
  simp only [↓reduceIte, Term.openVar, Term.openRec, Space.openRec_lc hlc]
  apply ValExpr.OpStep.appI_lin (b₀ := b) _ hsz _
  · apply ValExpr.OpStep.var
    change Finmap.lookup (y, Basis.dual b)
      (Finmap.insert (z, b) (.delta j.val sv)
        (Finmap.insert (y, Basis.dual b) (.delta i.val sv) Ψ)) = _
    rw [Finmap.lookup_insert_of_ne _ (by intro h; exact hzy (congrArg Prod.fst h).symm),
      Finmap.lookup_insert]
  · exact .var (Finmap.lookup_insert _)

noncomputable def antiSymBody (v w : Term) : Term :=
  .smul (.real (1 / 2)) (.add (.tprodE v w)
    (.smul (.real (-1)) (.tprodE w v)))

/-- The curried antisymmetrizer at an arbitrary opened tangent space. -/
noncomputable def antiSym (s : Space) : Term :=
  .llam s (.tprod (.dual s) (.tprod s s))
    (.llam s (.tprod s s) (antiSymBody (.bvar 1) (.bvar 0)))

/-- Its geometry-independent coordinate polynomial. -/
noncomputable def antiSymCode (sv : ValSpace) (v w : ValExpr) : ValExpr :=
  .scale (.rlit (1 / 2)) (.vadd (.tprod sv sv) (.tprodE v w)
    (.scale (.rlit (-1)) (.tprodE w v)))

/-- The actual curried operator generated by the two linear-lambda rules. -/
noncomputable def antiSymOperatorCode (sv : ValSpace) : ValExpr :=
  tensorColumns sv (.tprod sv (.tprod sv sv)) fun i =>
    tensorColumns sv (.tprod sv sv) fun j =>
      antiSymCode sv (.delta i.val sv) (.delta j.val sv)

/-- Coordinate entries for the input vectors suffice: no parameterization
matrix, metric, or inner-product operation enters the antisymmetric body. -/
theorem antiSymBody_op {Ψ : EvalCtx} {b : Basis} {sv : ValSpace}
    {v w : Term} {vv wv : ValExpr}
    (ht : b.tof = .space b.sof) (hs : ValSpace.EvalS Ψ b.sof sv)
    (hv : ValExpr.OpStep Ψ v b vv) (hw : ValExpr.OpStep Ψ w b wv) :
    ValExpr.OpStep Ψ (antiSymBody v w) (.tprod b b) (antiSymCode sv vv wv) :=
  .scale (.rlit _) (.add rfl (.tprod hs hs)
    (.tprodE hv hw ht ht) (.scale (.rlit _) (.tprodE hw hv ht ht)))

/-- Full lowering of the curried antisymmetrizer, with no desired-evaluation premise. -/
theorem antiSym_op {Ψ : EvalCtx} {b : Basis} {sv : ValSpace}
    (ht : b.tof = .space b.sof) (hlc : Space.lc b.sof)
    (hs : ValSpace.EvalS Ψ b.sof sv) :
    ValExpr.OpStep Ψ (antiSym b.sof)
      (.tprod (.dual b) (.tprod (.dual b) (.tprod b b))) (antiSymOperatorCode sv) := by
  unfold antiSym antiSymOperatorCode tensorColumns
  refine ValExpr.OpStep.llam_assemble (b' := b) (b := .tprod (.dual b) (.tprod b b)) ht hs (.tprod (.dual hs) (.tprod hs hs)) Ψ.avoid
    (fun y hy i => ?_)
  have hsy : ValSpace.EvalS (Ψ.extend y b (.delta i.val sv)) b.sof sv :=
    evalS_wk hs ((EvalCtx.avoid_spec hy).1 b)
  simp only [Nat.reduceAdd, Nat.reduceEqDiff, ↓reduceIte, Term.openVar, Term.openRec, Space.openRec, Space.openRec_lc hlc, antiSymBody]
  refine ValExpr.OpStep.llam_assemble (b' := b) (b := .tprod b b) ht hsy (.tprod hsy hsy)
    ((Ψ.extend y b (.delta i.val sv)).avoid ∪ {y}) (fun z hz j => ?_)
  have hzavoid : z ∉ (Ψ.extend y b (.delta i.val sv)).avoid :=
    fun h => hz (Finset.mem_union_left _ h)
  have hzy : z ≠ y := fun h => hz (Finset.mem_union_right _ (by simp [h]))
  have hsz := evalS_wk (v₀ := .delta j.val sv) hsy ((EvalCtx.avoid_spec hzavoid).1 b)
  simp only [↓reduceIte, Term.openVar, Term.openRec]
  apply antiSymBody_op ht hsz
  · apply ValExpr.OpStep.var
    change Finmap.lookup (y, b)
      (Finmap.insert (z, b) (.delta j.val sv)
        (Finmap.insert (y, b) (.delta i.val sv) Ψ)) = _
    rw [Finmap.lookup_insert_of_ne _ (by intro h; exact hzy (congrArg Prod.fst h).symm),
      Finmap.lookup_insert]
  · exact .var (Finmap.lookup_insert _)

/-- The scalar pairing occurring between assembled delta columns is the
Kronecker delta. This explains the identity tensor without claiming that the
operational relation performs constant folding. -/
theorem delta_pairing (n : Nat) (i j : Fin n) :
    (∑ k : Fin n, (if i = k then (1 : ℝ) else 0) *
      (if j = k then (1 : ℝ) else 0)) = if i = j then 1 else 0 := by
  simp only [ite_mul, one_mul, zero_mul]
  by_cases h : i = j <;> simp [h, Ne.symm]

/-- A normalized bivector measured in its corresponding normalized unit has
coefficient `a₀*b₁-a₁*b₀`. The half cancels from the measuring convention;
this does not require orthonormal generating vectors. -/
theorem normalized_tensor_area {V : Type*} [AddCommGroup V] [Module ℝ V]
    (p q : V) (a₀ a₁ b₀ b₁ : ℝ) :
    (1 / 2 : ℝ) •
      (TensorProduct.tmul ℝ (a₀ • p + a₁ • q) (b₀ • p + b₁ • q) -
        TensorProduct.tmul ℝ (b₀ • p + b₁ • q) (a₀ • p + a₁ • q)) =
      (a₀ * b₁ - a₁ * b₀) •
        ((1 / 2 : ℝ) • (TensorProduct.tmul ℝ p q - TensorProduct.tmul ℝ q p)) := by
  simp only [TensorProduct.add_tmul, TensorProduct.tmul_add,
    TensorProduct.smul_tmul, TensorProduct.tmul_smul]
  module

end GLang.Examples.TangentCoordinates
