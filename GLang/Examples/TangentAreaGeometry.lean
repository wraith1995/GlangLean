import GLang.Examples.TangentCoordinates
import GLang.Proofs.Adequacy.Raw.RawPinvCoordinateBridge
import GLang.Numerics.RREF.BasisLexInd

/-! Coordinate-free facts behind the rank-two area specialization. The
normalization and the order of the completed projected basis are explicit. -/
namespace GLang.Examples.TangentCoordinates
open scoped TensorProduct

noncomputable def antisymMap (V : HSpace) :
    (V.carrier ⊗[ℝ] V.carrier) →ₗ[ℝ] (V.carrier ⊗[ℝ] V.carrier) :=
  (1 / 2 : ℝ) • (LinearMap.id - (TensorProduct.comm ℝ V.carrier V.carrier).toLinearMap)

@[simp] theorem antisymMap_tmul (V : HSpace) (x y : V.carrier) :
    antisymMap V (x ⊗ₜ[ℝ] y) = (1 / 2 : ℝ) • (x ⊗ₜ[ℝ] y - y ⊗ₜ[ℝ] x) := by
  simp [antisymMap]

theorem antisymMap_idempotent (V : HSpace) (x : V.carrier ⊗[ℝ] V.carrier) :
    antisymMap V (antisymMap V x) = antisymMap V x := by
  induction x using TensorProduct.induction_on with
  | zero => simp
  | tmul x y =>
      simp only [antisymMap_tmul, map_smul, map_sub]
      module
  | add x y hx hy => simp only [map_add, hx, hy]

theorem antisymMap_selfAdjoint (V : HSpace) (x y : V.carrier ⊗[ℝ] V.carrier) :
    (HSpace.tprod V V).innerProduct (antisymMap V x) y =
      (HSpace.tprod V V).innerProduct x (antisymMap V y) := by
  induction x using TensorProduct.induction_on with
  | zero => simp
  | tmul a b =>
      induction y using TensorProduct.induction_on with
      | zero => simp
      | tmul c d =>
          simp only [antisymMap_tmul, map_smul, map_sub, LinearMap.smul_apply,
            LinearMap.sub_apply, HSpace.tprod, LinearMap.BilinForm.tmul, LinearMap.BilinForm.tensorDistrib_tmul, smul_eq_mul]
          ring
      | add y z hy hz => simp only [map_add, hy, hz]
  | add x y hx hy => simp only [map_add, LinearMap.add_apply, hx, hy]

/-- The Moore inverse of the actual inclusion into the tensor space is the
normalized antisymmetrizer with its range codomain. This uses the live source
pseudoinverse, and is valid for every inner product on the tangent space. -/
theorem antisymMap_projection (V : HSpace) :
    LinearMap.mooreInv
      (HSpace.ofSubmodule (HSpace.tprod V V) (antisymMap V).range).innerIsIP
      (HSpace.tprod V V).innerIsIP (antisymMap V).range.subtype =
      (antisymMap V).rangeRestrict := by
  symm
  apply LinearMap.eq_mooreInv_of_penrose
  · ext x
    obtain ⟨y, hy⟩ := x.property
    change antisymMap V x.val = x.val
    rw [← hy, antisymMap_idempotent]
  · apply LinearMap.ext
    intro x
    apply Subtype.ext
    exact antisymMap_idempotent V x
  · exact antisymMap_selfAdjoint V
  · intro x y
    have hx : antisymMap V x.val = x.val := by
      obtain ⟨z, hz⟩ := x.property
      rw [← hz, antisymMap_idempotent]
    have hy : antisymMap V y.val = y.val := by
      obtain ⟨z, hz⟩ := y.property
      rw [← hz, antisymMap_idempotent]
    change (HSpace.tprod V V).innerProduct (antisymMap V x.val) y.val =
      (HSpace.tprod V V).innerProduct x.val (antisymMap V y.val)
    rw [hx, hy]

noncomputable def areaGenerator (V : HSpace) (b : Module.Basis (Fin 2) ℝ V.carrier) :
    (antisymMap V).range := (antisymMap V).rangeRestrict (b 0 ⊗ₜ[ℝ] b 1)

theorem areaGenerator_ne_zero (V : HSpace) (b : Module.Basis (Fin 2) ℝ V.carrier) :
    areaGenerator V b ≠ 0 := by
  intro h
  have he := congrArg (fun z : (antisymMap V).range =>
    (b.tensorProduct b).repr z.val (0, 1)) h
  simp [areaGenerator, antisymMap_tmul,
    Module.Basis.tensorProduct_repr_tmul_apply] at he

/-- In rank two the whole alternating range is the line generated by the
second candidate. The coefficient is the unscaled determinant. -/
theorem antisymMap_coordinates (V : HSpace) (b : Module.Basis (Fin 2) ℝ V.carrier)
    (x y : V.carrier) :
    (antisymMap V).rangeRestrict (x ⊗ₜ[ℝ] y) =
      (b.repr x 0 * b.repr y 1 - b.repr x 1 * b.repr y 0) • areaGenerator V b := by
  apply Subtype.ext
  change antisymMap V (x ⊗ₜ[ℝ] y) = _
  have hx : x = b.repr x 0 • b 0 + b.repr x 1 • b 1 := by
    simpa only [Fin.sum_univ_two] using (b.sum_repr x).symm
  have hy : y = b.repr y 0 • b 0 + b.repr y 1 • b 1 := by
    simpa only [Fin.sum_univ_two] using (b.sum_repr y).symm
  rw [antisymMap_tmul]
  change _ = _ • ((1 / 2 : ℝ) • (b 0 ⊗ₜ[ℝ] b 1 - b 1 ⊗ₜ[ℝ] b 0))
  conv_lhs => rw [hx, hy]
  exact normalized_tensor_area _ _ _ _ _ _

theorem antisymMap_range_span (V : HSpace) (b : Module.Basis (Fin 2) ℝ V.carrier) :
    Submodule.span ℝ ({areaGenerator V b} : Set (antisymMap V).range) = ⊤ := by
  apply top_unique
  intro z hzmem
  obtain ⟨x, hx⟩ := z.property
  have hz : z = (antisymMap V).rangeRestrict x := Subtype.ext hx.symm
  rw [hz]
  clear hx hz hzmem z
  induction x using TensorProduct.induction_on with
  | zero => simp
  | tmul x y =>
      rw [antisymMap_coordinates]
      exact Submodule.smul_mem _ _ (Submodule.subset_span (Set.mem_singleton _))
  | add x y hx hy => simpa only [map_add] using Submodule.add_mem _ hx hy

private theorem lexIndAux_spanning {V : HSpace} (acc tail : List V.carrier)
    (hspan : Submodule.span ℝ {x | x ∈ acc} = ⊤) :
    HSpace.lexIndAux acc tail = acc := by
  induction tail with
  | nil => rfl
  | cons x xs ih =>
      have hx : x ∈ Submodule.span ℝ {x | x ∈ acc} := by rw [hspan]; trivial
      simp only [HSpace.lexIndAux, if_pos hx, ih]

/-- Exact LexInd order: zero, forward pair, reversed pair, zero, then the
fallback. The fallback contributes nothing once the forward pair is retained. -/
theorem projectedArea_lexInd (V : HSpace) (b : Module.Basis (Fin 2) ℝ V.carrier)
    (fallback : List (antisymMap V).range) :
    (HSpace.ofSubmodule (HSpace.tprod V V) (antisymMap V).range).lexInd
      ([(antisymMap V).rangeRestrict (b 0 ⊗ₜ[ℝ] b 0),
        (antisymMap V).rangeRestrict (b 0 ⊗ₜ[ℝ] b 1),
        (antisymMap V).rangeRestrict (b 1 ⊗ₜ[ℝ] b 0),
        (antisymMap V).rangeRestrict (b 1 ⊗ₜ[ℝ] b 1)] ++ fallback) =
      [areaGenerator V b] := by
  have hzero : (antisymMap V).rangeRestrict (b 0 ⊗ₜ[ℝ] b 0) = 0 := by
    ext; simp
  rw [hzero]
  change HSpace.lexIndAux (V := HSpace.ofSubmodule (HSpace.tprod V V) (antisymMap V).range) [] (0 :: areaGenerator V b :: _) = _
  rw [HSpace.lexIndAux, if_pos (Submodule.zero_mem _)]
  have hn : areaGenerator V b ∉ Submodule.span ℝ {x | x ∈ ([] : List (antisymMap V).range)} := by
    simpa using areaGenerator_ne_zero V b
  rw [HSpace.lexIndAux, if_neg hn]
  exact lexIndAux_spanning (V := HSpace.ofSubmodule (HSpace.tprod V V) (antisymMap V).range) _ _ (by simpa using antisymMap_range_span V b)

end GLang.Examples.TangentCoordinates
